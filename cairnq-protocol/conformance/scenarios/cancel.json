{
  "name": "cancel",
  "description": "§32.10 — queued task cancels immediately; running task gets cancel_requested_at_ms (cooperative)",
  "steps": [
    { "op": "submit", "args": { "name": "job", "payload": {} }, "save": "tq" },
    { "op": "cancel", "args": { "id": "$tq.id" }, "save": "cq", "expect": { "equals": { "status": "canceled" } } },

    { "op": "submit", "args": { "name": "job", "payload": {} }, "save": "tr" },
    { "op": "claim", "args": { "queues": ["default"], "worker_id": "w1", "lease_ms": 5000 }, "save": "c", "expect": { "length": 1 } },
    { "op": "cancel", "args": { "id": "$tr.id" }, "save": "cr", "expect": { "equals": { "status": "running" } } },
    { "op": "get", "args": { "id": "$tr.id" }, "save": "g", "expect": { "notNull": ["cancel_requested_at_ms"] } }
  ]
}
