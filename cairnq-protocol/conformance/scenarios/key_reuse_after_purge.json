{
  "name": "key_reuse_after_purge",
  "description": "a key whose recorded task was purged is free again: the key row cascades away with the task, so a keyed submit creates a NEW task under the same key instead of resurrecting the old id",
  "steps": [
    { "op": "submit", "args": { "name": "job", "payload": {}, "key": "A", "conflict": "reuse" }, "save": "t1" },
    { "op": "claim", "args": { "queues": ["default"], "worker_id": "w1", "lease_ms": 5000 }, "expect": { "length": 1 } },
    { "op": "succeed", "args": { "id": "$t1.id", "worker_id": "w1", "result": { "n": 1 } }, "expect": { "equals": { "status": "succeeded" } } },
    { "op": "sleep", "args": { "ms": 50 } },
    { "op": "purge", "args": { "older_than_ms": 0, "limit": 100 }, "expect": { "length": 1 } },

    { "op": "submit", "args": { "name": "job", "payload": {}, "key": "A", "conflict": "reuse" }, "save": "t2", "expect": { "equals": { "status": "queued" } } },
    { "op": "get_by_key", "args": { "key": "A" }, "expect": { "equals": { "status": "queued" } } }
  ]
}
