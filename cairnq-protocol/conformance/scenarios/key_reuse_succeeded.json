{
  "name": "key_reuse_succeeded",
  "description": "conflict=reuse-succeeded reads a succeeded task as a cached result: the second submit returns the same task, result and all. It still deduplicates in-flight work like reuse does.",
  "steps": [
    { "op": "submit", "args": { "name": "job", "payload": {}, "key": "A", "conflict": "reuse-succeeded" }, "save": "t1" },
    { "op": "submit", "args": { "name": "job", "payload": {}, "key": "A", "conflict": "reuse-succeeded" }, "save": "t1b", "expect": { "equals": { "status": "queued" } } },
    { "op": "expect", "target": "$t1b.id", "equalsRef": "$t1.id" },

    { "op": "claim", "args": { "queues": ["default"], "worker_id": "w1", "lease_ms": 5000 }, "expect": { "length": 1 } },
    { "op": "complete", "args": { "id": "$t1.id", "worker_id": "w1", "result": { "n": 1 } }, "expect": { "equals": { "status": "succeeded" } } },

    { "op": "submit", "args": { "name": "job", "payload": {}, "key": "A", "conflict": "reuse-succeeded" }, "save": "t2", "expect": { "equals": { "status": "succeeded", "result": { "n": 1 } } } },
    { "op": "expect", "target": "$t2.id", "equalsRef": "$t1.id" }
  ]
}
