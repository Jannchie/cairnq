{
  "name": "final_failure",
  "description": "§32.9 — fail at max_attempts becomes terminal 'failed' and retains the error",
  "steps": [
    { "op": "submit", "args": { "name": "job", "payload": {}, "max_attempts": 1 }, "save": "t" },
    { "op": "claim", "args": { "queues": ["default"], "worker_id": "w1", "lease_ms": 5000 }, "save": "c1", "expect": { "length": 1 } },
    { "op": "fail", "args": { "id": "$t.id", "worker_id": "w1", "error": { "type": "E", "code": "e", "message": "boom", "retryable": true }, "retryable": true, "delay_ms": 0 }, "save": "f1", "expect": { "equals": { "status": "failed" } } },
    { "op": "get", "args": { "id": "$t.id" }, "save": "g", "expect": { "equals": { "status": "failed" } } },
    { "op": "expect", "target": "$g.error", "equals": { "code": "e" } }
  ]
}
