{
  "name": "claim_filters_by_handler_name",
  "description": "claim takes only tasks the caller can actually run. Without the filter a worker claims a task it has no handler for and fails it permanently, so two workers with different handler sets on one queue destroy each other's tasks. Omitting names keeps the unfiltered behavior every other scenario relies on.",
  "steps": [
    { "op": "submit", "args": { "name": "alpha", "payload": {} }, "save": "a" },
    { "op": "submit", "args": { "name": "beta", "payload": {} }, "save": "b" },

    { "op": "claim", "args": { "queues": ["default"], "worker_id": "w_alpha", "names": ["alpha"], "lease_ms": 5000, "limit": 10 }, "save": "c1", "expect": { "length": 1 } },
    { "op": "expect", "target": "$c1.0.id", "equalsRef": "$a.id" },

    { "op": "get", "args": { "id": "$b.id" }, "expect": { "equals": { "status": "queued", "attempt": 0 } } },

    { "op": "claim", "args": { "queues": ["default"], "worker_id": "w_beta", "names": ["beta"], "lease_ms": 5000, "limit": 10 }, "save": "c2", "expect": { "length": 1 } },
    { "op": "expect", "target": "$c2.0.id", "equalsRef": "$b.id" },

    { "op": "submit", "args": { "name": "gamma", "payload": {} }, "save": "g" },
    { "op": "claim", "args": { "queues": ["default"], "worker_id": "w_none", "names": [], "lease_ms": 5000, "limit": 10 }, "expect": { "length": 0 } },
    { "op": "claim", "args": { "queues": ["default"], "worker_id": "w_any", "lease_ms": 5000, "limit": 10 }, "save": "c3", "expect": { "length": 1 } },
    { "op": "expect", "target": "$c3.0.id", "equalsRef": "$g.id" }
  ]
}
